# Application
APP_NAME=ai-secure-dev-template
APP_ENV=local
APP_DEBUG=false

# API
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth
AUTH_PROVIDER=
FIREBASE_PROJECT_ID=

# Database
DATABASE_URL=

# External services
EXTERNAL_API_BASE_URL=

# Logging
LOG_LEVEL=INFO

# Security
SECRET_KEY=replace-with-local-dev-only-value
